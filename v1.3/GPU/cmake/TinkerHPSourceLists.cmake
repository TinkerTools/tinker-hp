function(tinkerhp_partition_fortran_sources out_common out_gpu)
  set(_gpu_sources "")
  set(_common_sources "")
  foreach(_src IN LISTS F_SRCS)
    get_filename_component(_name "${_src}" NAME)
    if(_name MATCHES "gpu\\.f90$"
        OR _name MATCHES "^e.*\\.f90$"
        OR _name MATCHES "^k.*\\.f90$"
        OR _name MATCHES "^(active|attach|angles|bonds|bitors|cluster|domdecstuff|lattice|torsions)\\.f90$")
      list(APPEND _gpu_sources "${_src}")
    else()
      list(APPEND _common_sources "${_src}")
    endif()
  endforeach()
  set(${out_common} "${_common_sources}" PARENT_SCOPE)
  set(${out_gpu} "${_gpu_sources}" PARENT_SCOPE)
endfunction()
