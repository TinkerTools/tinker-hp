function(tinkerhp_generate_build_report)
  set(options)
  set(oneValueArgs
    OUTPUT
    CMAKE_BUILD_TYPE
    CMAKE_C_COMPILER
    CMAKE_CXX_COMPILER
    CMAKE_Fortran_COMPILER
    CMAKE_CUDA_COMPILER
    CMAKE_CXX_COMPILER_ID
    CMAKE_CXX_COMPILER_VERSION
    CMAKE_Fortran_COMPILER_ID
    CMAKE_Fortran_COMPILER_VERSION
    CMAKE_CUDA_COMPILER_ID
    CMAKE_CUDA_COMPILER_VERSION
    TINKERHP_BACKEND
    TINKERHP_PRECISION
    TINKERHP_LINK_MODE
    TINKERHP_ENABLE_ORTHO_BOX_ONLY
    TINKERHP_ENABLE_FPA
    TINKERHP_ENABLE_NVTX
    TINKERHP_ENABLE_NO_MUTATION
    TINKERHP_ENABLE_NN
    TINKERHP_DEEPHP_ENVIRONMENT_ORIGIN
    TINKERHP_DEEPHP_PYTHON
    TINKERHP_DEEPHP_PYTHON_VERSION
    TINKERHP_DEEPHP_CUDA_PROFILE
    TINKERHP_EFFECTIVE_BINARY_SUFFIX
    TINKERHP_GPU_ARCHITECTURES
    TINKERHP_DETECTED_CUDA_VERSION
    TINKERHP_ENABLE_PLUMED
    PLUMED_SOURCE_HOME
    PLUMED_HOME
    TINKERHP_PLUMED_LIBRARY
    TINKERHP_PLUMED_KERNEL_LIBRARY
    TINKERHP_ENABLE_COLVARS
    COLVARS_HOME
    TCL_HOME
    TINKERHP_COLVARS_TCL_INCLUDE_DIR
    TINKERHP_COLVARS_TCL_LIBRARY
    TINKERHP_COLVARS_MPI_VERSION
    TINKERHP_COLVARS_MPI_CXX_LIBRARY
    CMAKE_INSTALL_PREFIX
    TINKERHP_INSTALL_BINDIR
  )
  set(multiValueArgs
    TINKERHP_COMMON_FORTRAN_FLAGS
    TINKERHP_CUDA_FORTRAN_FLAGS
    TINKERHP_CXX_FLAGS
    TINKERHP_CUDA_FLAGS
    TINKERHP_MAIN_PREPROCESS_DEFINITIONS
    TINKERHP_CUDA_PREPROCESS_DEFINITIONS
    TINKERHP_2DECOMP_PREPROCESS_DEFINITIONS
    TINKERHP_PLUMED_PREPROCESS_DEFINITIONS
    TINKERHP_COLVARS_PREPROCESS_DEFINITIONS
  )
  cmake_parse_arguments(REPORT "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

  string(JOIN " " _common_fortran_flags ${REPORT_TINKERHP_COMMON_FORTRAN_FLAGS})
  string(JOIN " " _cuda_fortran_flags ${REPORT_TINKERHP_CUDA_FORTRAN_FLAGS})
  string(JOIN " " _cxx_flags ${REPORT_TINKERHP_CXX_FLAGS})
  string(JOIN " " _cuda_flags ${REPORT_TINKERHP_CUDA_FLAGS})
  string(JOIN " " _main_preprocess_definitions ${REPORT_TINKERHP_MAIN_PREPROCESS_DEFINITIONS})
  string(JOIN " " _cuda_preprocess_definitions ${REPORT_TINKERHP_CUDA_PREPROCESS_DEFINITIONS})
  string(JOIN " " _2decomp_preprocess_definitions ${REPORT_TINKERHP_2DECOMP_PREPROCESS_DEFINITIONS})
  string(JOIN " " _plumed_preprocess_definitions ${REPORT_TINKERHP_PLUMED_PREPROCESS_DEFINITIONS})
  string(JOIN " " _colvars_preprocess_definitions ${REPORT_TINKERHP_COLVARS_PREPROCESS_DEFINITIONS})

  set(_content [=[
Tinker-HP CMake Build Report
============================

Build type: @REPORT_CMAKE_BUILD_TYPE@

Compilers
---------
C: @REPORT_CMAKE_C_COMPILER@
C++: @REPORT_CMAKE_CXX_COMPILER@ (@REPORT_CMAKE_CXX_COMPILER_ID@ @REPORT_CMAKE_CXX_COMPILER_VERSION@)
Fortran: @REPORT_CMAKE_Fortran_COMPILER@ (@REPORT_CMAKE_Fortran_COMPILER_ID@ @REPORT_CMAKE_Fortran_COMPILER_VERSION@)
CUDA: @REPORT_CMAKE_CUDA_COMPILER@ (@REPORT_CMAKE_CUDA_COMPILER_ID@ @REPORT_CMAKE_CUDA_COMPILER_VERSION@)

Configuration
-------------
Backend: @REPORT_TINKERHP_BACKEND@
Precision: @REPORT_TINKERHP_PRECISION@
Link mode: @REPORT_TINKERHP_LINK_MODE@
Orthogonal-box-only enabled: @REPORT_TINKERHP_ENABLE_ORTHO_BOX_ONLY@
FPA enabled: @REPORT_TINKERHP_ENABLE_FPA@
NVTX enabled: @REPORT_TINKERHP_ENABLE_NVTX@
No-mutation enabled: @REPORT_TINKERHP_ENABLE_NO_MUTATION@
Deep-HP NN enabled: @REPORT_TINKERHP_ENABLE_NN@
Deep-HP environment origin: @REPORT_TINKERHP_DEEPHP_ENVIRONMENT_ORIGIN@
Deep-HP interpreter: @REPORT_TINKERHP_DEEPHP_PYTHON@
Deep-HP Python version: @REPORT_TINKERHP_DEEPHP_PYTHON_VERSION@
Deep-HP CUDA profile: @REPORT_TINKERHP_DEEPHP_CUDA_PROFILE@
Binary suffix: @REPORT_TINKERHP_EFFECTIVE_BINARY_SUFFIX@
GPU architectures: @REPORT_TINKERHP_GPU_ARCHITECTURES@
Detected CUDA version: @REPORT_TINKERHP_DETECTED_CUDA_VERSION@
PLUMED enabled: @REPORT_TINKERHP_ENABLE_PLUMED@
PLUMED source directory: @REPORT_PLUMED_SOURCE_HOME@
PLUMED installation prefix: @REPORT_PLUMED_HOME@
PLUMED runtime library directory: @REPORT_PLUMED_HOME@/lib (add this to LD_LIBRARY_PATH)
PLUMED library: @REPORT_TINKERHP_PLUMED_LIBRARY@
PLUMED kernel library: @REPORT_TINKERHP_PLUMED_KERNEL_LIBRARY@
Colvars enabled: @REPORT_TINKERHP_ENABLE_COLVARS@
COLVARS_HOME: @REPORT_COLVARS_HOME@
TCL_HOME: @REPORT_TCL_HOME@
TCL include directory: @REPORT_TINKERHP_COLVARS_TCL_INCLUDE_DIR@
TCL library: @REPORT_TINKERHP_COLVARS_TCL_LIBRARY@
OpenMPI version: @REPORT_TINKERHP_COLVARS_MPI_VERSION@
OpenMPI C++ compatibility library: @REPORT_TINKERHP_COLVARS_MPI_CXX_LIBRARY@

Flags
-----
Fortran: @_common_fortran_flags@
CUDA Fortran: @_cuda_fortran_flags@
C++: @_cxx_flags@
CUDA: @_cuda_flags@

Effective preprocessor definitions
----------------------------------
Main Tinker-HP targets (Fortran/C++/CUDA): @_main_preprocess_definitions@
CUDA-only Tinker-HP targets: @_cuda_preprocess_definitions@
2decomp_fft (Fortran): @_2decomp_preprocess_definitions@
PLUMED-enabled Tinker-HP targets (Fortran/CUDA): @_plumed_preprocess_definitions@
Colvars-enabled Tinker-HP targets (Fortran/C++/CUDA): @_colvars_preprocess_definitions@
Wrappers: none

Install
-------
Prefix: @REPORT_CMAKE_INSTALL_PREFIX@
Binary destination: @REPORT_TINKERHP_INSTALL_BINDIR@
]=])

  string(CONFIGURE "${_content}" _configured @ONLY)
  file(GENERATE OUTPUT "${REPORT_OUTPUT}" CONTENT "${_configured}")
endfunction()
