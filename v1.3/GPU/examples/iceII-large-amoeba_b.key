parameters         ../params/water03
verbose

#vdw-correction
vdw-cutoff         9.0
ewald
ewald-cutoff       7
dewald
dewald-cutoff      7
list-buffer        1.0
#vdw-cutoff 10

#spacegroup               R3(-)
#a-axis                   38.90
a-axis              77.80
b-axis              46.68
c-axis              31.12
alpha              113.10
beta               113.10
gamma              113.10
integrator         baoab
barostat           langevin
#polarizeterm none
polar-alg          1
polar-predict      none
polar-guess        1
polar-eps          1e-7
#polar-prt          1
#dd-cutoff          6
#pme-procs          1

run-mode           legacy
printout           100
archive
no-minimize-xyz
