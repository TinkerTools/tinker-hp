#
##  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
### Keyfile for MD Benchmark on CHARMM DHFR/Water Box
##  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#

parameters            ../params/charmm22
verbose

integrator            respa
dshort                0.001
dinter                0.004
respa-inner           1
#heavy-hydrogen

## Simulation Mode Params (NVE,NVT,NPT)
#  >>>>>>>>>>>>>>>>>>>
randomseed            123456789
thermostat            BUSSI
#barostat              montecarlo
#host-random-platform
#virialterm
#rattle
remove-inertia        100
#decomp1D

## Define the Periodic Box and Cutoffs
#  >>>>>>>>>>>>>>>>>>>
a-axis                62.23
vdw-cutoff            9.0
#vdwtype               LENNARD-JONES

## Neighbor list setup parameters
neighbor-list
#list-buffer           1.0
#nlupdate              5
#matlist-buffer        1.0

##  Set Parameters for Ewald Summation
ewald
ewald-cutoff          7.0
pme-grid              64 64 64

## Execution output flow & Configuration keys
#  >>>>>>>>>>>>>>>>>>>
#                     fedcba9876543210
#config-routine        0000131101110000
#config-routine        0111142402220000
#pme-procs             1
#archive
#printout              5000          #prevent bottleneck on stdout
#run-mode              legacy
#run-mode              adapted


## Tinker Keys params
#  >>>>>>>>>>>>>>>>>>>
#openmp-threads        1
#neighbor-list
