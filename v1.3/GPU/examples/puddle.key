#
#  Keyfile for MD on puddle in Water Box (AMOEBA)
#
parameters          ../params/water
integrator          baoabrespa1
dshort              0.001
dinter              0.004
heavy-hydrogen
verbose
randomseed          123456789
a-axis              98.5
vdw-cutoff          9.0
ewald
ewald-cutoff        7.0 
polar-alg           1
polar-eps           0.00001

#host-random-platform
#virialterm
