#
##  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
### Keyfile for MD on COX-2 in Water Box (Charmm)
##  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#

parameters            ../params/charmm22
verbose

integrator            respa
dshort                0.00025
dinter                0.004
#heavy-hydrogen

## Simulation Mode Params (NVE,NVT,NPT)
#  >>>>>>>>>>>>>>>>>>>
randomseed            123456789
#thermostat           BUSSI
#barostat             montecarlo
#host-random-platform
#virialterm
remove-inertia        100
decomp1D

## Define the Periodic Box and Cutoffs
#  >>>>>>>>>>>>>>>>>>>
a-axis                120.0
vdw-cutoff            9.0
#vdw-correction

## Neighbor list setup parameters
neighbor-list
#list-buffer           1
#nlupdate              2
#matlist-buffer        1.0

## Set Parameters for Ewald Summation
#  >>>>>>>>>>>>>>>>>>>
ewald
ewald-cutoff          7.0
pme-grid              128 128 128

## Set Parameters for Induced Dipole Convergence
#  >>>>>>>>>>>>>>>>>>>
#polar-alg             1
#polar-eps             0.00001
#polar-prt             2
#precompute-multipole
#polar-precomp         1     #Require memory
#polar-predict       other

## Execution output flow & Configuration keys
#  >>>>>>>>>>>>>>>>>>>
#                     fedcba9876543210
#config-routine        0011131102210000
#run-mode              adapted
#pme-procs             1
#pme-procs             4
#archive
printout              5000
