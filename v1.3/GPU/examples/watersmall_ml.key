#!
parameters           ../params/water03.prm
verbose
integrator           VERLET
thermostat           BUSSI
barostat             MONTECARLO

a-axis               18.643

list-buffer          0.2
vdw-cutoff           9.0
ewald
ewald-cutoff         7.0
archive
#restrain-position   1 0.0 0.0 0.0 50

#group                1    -1 3

mlpot                only
#mlpot                embd
mlpot-cutoff         5.5
ml-model             ../ml_models/ani2x.fnx

polar-alg            1
polar-eps            1e-5
#polar-prt            2
#polar-predict        none
#polar-guess          1
#polarizeterm         none
#mpoleterm            none

run-mode             adapted
randomseed           234156931
printout             100
#host-random-platform
#virialterm
