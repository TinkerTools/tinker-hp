#
##  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
### Keyfile for MD on COX-2 in Water Box (Charmm)
##  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#

parameters            ../params1/amoebapro13
verbose

integrator            respa
dshort                0.001
dinter                0.004
#heavy-hydrogen

## Simulation Mode Params (NVE,NVT,NPT)
#  >>>>>>>>>>>>>>>>>>>
randomseed            123456789
#thermostat           BUSSI
#barostat             montecarlo
#host-random-platform
#virialterm

## Define the Periodic Box and Cutoffs
#  >>>>>>>>>>>>>>>>>>>
a-axis                120.0
vdw-cutoff            9.0
#vdw-correction

## Neighbor list setup parameters
#list-buffer           1
#nlupdate              2
#matlist-buffer        1.0

## Set Parameters for Ewald Summation
#  >>>>>>>>>>>>>>>>>>>
ewald
ewald-cutoff          7.0
pme-grid              128 128 128

## Set Parameters for Induced Dipole Convergence
#  >>>>>>>>>>>>>>>>>>>
polar-alg             1
polar-eps             0.00001
#polar-prt             2
#polar-predict       other

## Execution output flow & Configuration keys
#  >>>>>>>>>>>>>>>>>>>
#                     fedcba9876543210
#config-routine        0011131102210000
#config-routine        0011252402220001
#run-mode               adapted
#pme-procs             1
#pme-procs             4
#archive
#printout              1000
#iwrite                50

neighbor-list
#openmp-threads         1
#cuda-device            1
#cuda-precision         mixed
