#
##  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
### Keyfile for MD on dhfr2 (AMOEBA)
##  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#

parameters           ../params/amoebabio09
verbose

integrator            baoabrespa1
dshort                0.001
dinter                0.004
heavy-hydrogen

## Simulation Mode Params (NVE,NVT,NPT)
#  >>>>>>>>>>>>>>>>>>>
randomseed            243730118
#thermostat           BUSSI
barostat              montecarlo
#host-random-platform
virialterm

## Define the Periodic Box and Cutoffs
#  >>>>>>>>>>>>>>>>>>>
a-axis                62.23
vdw-cutoff            12.0
decomp1D
#decomp3D            1 1 4
#vdw-correction

## Neighbor list setup parameters
#list-buffer           1
#nlupdate              2
#matlist-buffer        0.000010

## Set Parameters for Ewald Summation
#  >>>>>>>>>>>>>>>>>>>
ewald
ewald-cutoff          7.0
#ewald-boundary
pme-grid              64 64 64

## Set Parameters for Induced Dipole Convergence
#  >>>>>>>>>>>>>>>>>>>
polar-alg             1
polar-eps             1e-6
#polar-prt             2
#precompute-multipole
#quick-polar-solve     #Require memory
#polar-predict         svls #none
#polar-guess           1
#polar-predict-dim     2

#track-mdstate         50
#fwrite-mdstate

#vdwterm               none
#mpoleterm             none
#polarizeterm          none

## Execution output flow & Configuration keys
#  >>>>>>>>>>>>>>>>>>>
#                     fedcba9876543210
#config-routine        0000131101110000
#config-routine        0011242402220001
#run-mode              adapted
#pme-procs             1
#pme-procs             4
#printout              1000
#iwrite                5
#archive
dcdio

## Tinker/Tinker-OpenMM Keys params
#  >>>>>>>>>>>>>>>>>>>
#polarization        MUTUAL
#neighbor-list
#openmp-threads       1
#cuda-precision       mixed
#cuda-device          0
