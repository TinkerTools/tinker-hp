	$(AM_V_CXX_no)$(CXX) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(libtinkerclv_a_CXXFLAGS) $(CXXFLAGS) -c -o libtinkerclv_a-colvarproxy_tinkerhp.o `test -f 'colvarproxy_tinkerhp.cpp' || echo '$(srcdir)/'`colvarproxy_tinkerhp.cpp

