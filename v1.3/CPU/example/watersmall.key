parameters        ../params/water03
verbose

a-axis                       18.643
integrator verlet
integrator baoab
thermostat                    BUSSI
#barostat                 MONTECARLO
barostat langevin
polar-alg 1

list-buffer                     0.1
vdw-cutoff                      9.0
ewald
ewald-cutoff                    7.0

polarization                 MUTUAL
polar-eps                   0.00001
polar-predict

